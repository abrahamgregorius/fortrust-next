# EmailJS Configuration
# Get these values from https://dashboard.emailjs.com/

NEXT_PUBLIC_EMAILJS_SERVICE_ID=your_service_id_here
NEXT_PUBLIC_EMAILJS_TEMPLATE_ID=your_template_id_here
NEXT_PUBLIC_EMAILJS_PUBLIC_KEY=your_public_key_here

# ---------------------------------------------------------------------------
# AI Article Generator
# ---------------------------------------------------------------------------

# Gemini API key (server-only) — used to research topics and write articles
GEMINI_API_KEY=your_gemini_api_key_here

# Shared secret for automated runs (cron / GitHub Actions / any scheduler).
# The scheduler sends this in the `x-cron-secret` header.
# Generate one with:  openssl rand -hex 32
CRON_SECRET=your_random_secret_here

# Public URL of the running app — used by the scheduler scripts.
# Example: https://fortrust.com
APP_URL=https://fortrust.com

# Optional — comma-separated list of admin emails allowed to use the AI writer.
# Leave empty to allow any signed-in admin.
BLOG_AI_ALLOWED_EMAILS=
